layout(std430, binding = 0) buffer Buffer_Radiance { vec4 inRadiance[]; };
layout(std430, binding = 1) buffer Buffer_GBuffer { GBuffer inGbuffer[]; };

layout(binding = 0, rgba16f) uniform image2D imgHistory;
layout(binding = 1, rgba16f) uniform image2D imgHistoryPos;
layout(binding = 2, rgba16f) uniform image2D imgHistoryMoment;

layout(binding = 2) uniform sampler2D samplerHistory;
layout(binding = 3) uniform sampler2D samplerHistoryPos;
layout(binding = 4) uniform sampler2D samplerHistoryMoment;

FnSceneMapStub;

void main() {
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	int idx = px.y * skResolution.x + px.x;
	vec4 col = inRadiance[idx];
	vec3 P = inGbuffer[idx].ori;
	bool hasSurface = inGbuffer[idx].materialId >= 0.0;

	if (skAnimate == 0 && iFrame > 100) { return; }

	if (iFrame == 0 || !hasSurface) {
		float lum0 = dot(col.rgb, vec3(0.2126, 0.7152, 0.0722));
		imageStore(imgHistory, px, col);
		imageStore(imgHistoryPos, px, vec4(P, 1.0));
		imageStore(imgHistoryMoment, px, vec4(lum0, lum0*lum0, 0.0f, 1.0f));
		return;
	}

	vec3 camOriPrev, camTgtPrev; float fovPrev;
	fnCameraFromSlots(iFrame-1, camOriPrev, camTgtPrev, fovPrev);
	vec3 camOriCur, camTgtCur; float fovCur;
	fnCameraFromSlots(iFrame, camOriCur, camTgtCur, fovCur);

	float aspect = float(skResolution.x) / float(skResolution.y);
	vec2 uvPrev;
	bool onScreen = fnWorldToScreen(P, camOriPrev, camTgtPrev, fovPrev, uvPrev);
	uvPrev.x /= aspect;
	vec2 uvS = uvPrev*0.5 + 0.5;
	vec2 pxF = uvS * vec2(skResolution) - 0.5;

	bool valid = false;
	vec4 hist = vec4(0.0);
	if (onScreen && all(greaterThanEqual(pxF, vec2(0))) && all(lessThan(pxF, vec2(skResolution)))) {
		hist = texture(samplerHistory, uvS);
		vec3 prevPos = texture(samplerHistoryPos, uvS).rgb;
		// disocclusion
		const float footprint = (
			(uSlots[32]==0.0f?0.01f:uSlots[32]*0.01f) * distance(P, camOriCur)
		);
		valid = distance(P, prevPos) < max(footprint, 1e-3);
	}

	vec3 outRgb; float outCount;
	if (valid) {
		const float histCount = min(hist.a, 128.0);
		const float alpha = col.a / (histCount + col.a);
		const float lumC = dot(col.rgb, vec3(0.2126, 0.7152, 0.0722));

		// -- spation moment from 3x3 neighborhood
		float sm1 = 0.0f;
		float sm2 = 0.0f;
		int count = 0;
		for (int dy = -1; dy <= 1; ++dy)
		for (int dx = -1; dx <= 1; ++dx) {
			ivec2 npx = px + ivec2(dx, dy);
			if (
				   any(lessThan(npx, ivec2(0)))
				|| any(greaterThanEqual(npx, ivec2(skResolution)))
			) {
				continue;
			}
			const float nl = (
				dot(
					inRadiance[npx.y*skResolution.x + npx.x].rgb,
					vec3(0.2126, 0.7152, 0.0722)
				)
			);
			sm1 += nl;
			sm2 += nl*nl;
			++count;
		}
		sm1 /= float(count);
		sm2 /= float(count);
		const float spatialVariance = max(sm2 - sm1*sm1, 0.0f);

		// -- temporal moment accumulation
		const vec2 histMoments = texture(samplerHistoryMoment, uvS).rg;
		const float newM1 = mix(histMoments.x, lumC, alpha);
		const float newM2 = mix(histMoments.y, lumC*lumC, alpha);
		const float temporalVariance = max(newM2 - newM1*newM1, 0.0f);

		// use spatial variance for first few frames, blend to temporal
		const float blend = clamp((histCount - 1.0f) / 4.0f, 0.0f, 1.0f);
		const float variance = mix(spatialVariance, temporalVariance, blend);

		// store moment for next frame
		imageStore(imgHistoryMoment, px, vec4(newM1, newM2, 0.0f, 1.0f));

		// -- color bbox clamp using spatial neighborhood variance
		vec3 ncMin = col.rgb;
		vec3 ncMax = col.rgb;
		for (int dy = -1; dy <= 1; ++dy)
		for (int dx = -1; dx <= 1; ++dx) {
			ivec2 npx = px + ivec2(dx, dy);
			if (
				   any(lessThan(npx, ivec2(0)))
				|| any(greaterThanEqual(npx, ivec2(skResolution)))
			) {
				continue;
			}
			const vec3 ncol = inRadiance[npx.y*skResolution.x + npx.x].rgb;
			ncMin = min(ncMin, ncol);
			ncMax = max(ncMax, ncol);
		}

		// k tunes aggressiveness of clamp. b/c of low spp this is very low
		float k = 0.55f;
		const vec3 sigma = (ncMax - ncMin) * 0.5f;
		const vec3 mean = (ncMax + ncMin) * 0.5f;

		// now finally mix history
		hist.rgb = clamp(hist.rgb, mean - k*sigma, mean + k*sigma);
		outRgb = mix(hist.rgb, col.rgb, alpha);
		outCount = histCount + col.a;
	} else {
		const float lumC = dot(col.rgb, vec3(0.2126, 0.7152, 0.0722));
		imageStore(imgHistoryMoment, px, vec4(lumC, lumC*lumC, 0.0f, 1.0f));
		outRgb = col.rgb;
		outCount = col.a;
	}

	imageStore(imgHistory, px, vec4(outRgb, outCount));
	imageStore(imgHistoryPos, px, vec4(P, 1.0));

	// if (iFrame != 0) {
	// 	// we want to sticky alphas < 1.0f for debugging.
	// 	if (col.a < 0.0f || hist.a < 0.0f) {
	// 		const f32v3 randCol = (
	// 			iFrame%20 < 5 ? vec3(1.0f, 0.0f, 0.0f) : vec3(0.0f, 1.0f, 0.0f)
	// 		);
	// 		imageStore(imgHistory, px, vec4(randCol*1000.0f, -99.0f));
	// 		return;
	// 	}
	// }
}
