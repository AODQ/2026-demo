f32v2 fnSceneMapLights(f32v3 o) {
	f32v2 res = f32v2(999999.0f, -1.0f);
	for (int i = 0; i < skLightsMax; ++i) {
		if (
			   inLight[i].emission.x <= 0.0f
			&& inLight[i].emission.y <= 0.0f
			&& inLight[i].emission.z <= 0.0f
		) {
			break;
		}
		const Light l = inLight[i];
		const f32v3 up = (
			l.nor.y > 0.99f ? f32v3(0.0, 0.0, 1.0) : f32v3(0.0, 1.0, 0.0)
		);
		const f32v3 ori = inverse(fnLookAt(l.nor, up)) * (o - l.ori);

		Union(res, sdBox(ori, f32v3(0.01, l.halfExtent)), 100.0 + float(i));
	}
	return res;
}

// -----------------------------------------------------------------------------
// -- emission
// -----------------------------------------------------------------------------

f32v3 fnEmitterSample(
	int lightIndex,
	f32v3 normal,
	inout f32v2 seed2
) {
	if (lightIndex == skLightIndexSky) {
		// uniform sampling of the hemisphere for sky
		vec2 u = fnSampleUniform2(seed2);
		f32v3 dir = Reorient_Hemisphere(
			normalize(To_Cartesian(sqrt(u.y), TAU*u.x)),
			normal
		);
		return dir*1e6f;
	}
	const f32v2 uv = (fnSampleUniform2(seed2) - 0.5f) * 2.0f;
	const Light light = inLight[lightIndex];
	// sample a point on the surface of the light
	const f32v3 referenceAxis = (
		abs(light.nor.y) < 0.99 ? f32v3(1,0,0) : f32v3(0,1,0)
	);
	const f32v3 tangent = normalize(cross(referenceAxis, light.nor));
	const f32v3 bitangent = cross(light.nor, tangent);
	const f32v3 samplePoint = (
		  light.ori
		+ uv.x*light.halfExtent.x*tangent
		+ uv.y*light.halfExtent.y*bitangent
	);
	return samplePoint;
 }

f32v3 fnEmitterF(int lightIndex, f32v3 wo) {
	if (lightIndex == skLightIndexSky) {
		return skLightSkyEmission;
	}
	return inLight[lightIndex].emission;
}

f32 fnEmitPdf(int lightIndex, f32v3 wo, f32 dist) {
	if (lightIndex == skLightIndexSky) {
		// uniform sampling of the hemisphere for sky
		return 1.0f / (2.0f * PI);
	}
	const Light l = inLight[lightIndex];
	const f32 area = 4.0f * l.halfExtent.x * l.halfExtent.y;
	// no need for max(dot(N, wo), 0) because fnValidEmitter will cull direction
	const f32 dotNorWo = abs(dot(l.nor, wo));
	return (dist * dist) / (area * max(dotNorWo, 0.001f));
}

bool fnValidEmitter(int lightIndex, f32v3 wo) {
	if (lightIndex < 0 || lightIndex >= skLightsInSceneInclSky) {
		return false;
	}
	if (lightIndex == skLightIndexSky) {
		// sky is visible from all directions
		return true;
	}
	const Light l = inLight[lightIndex];
	return dot(l.nor, wo) > 0.0f;
}

// -----------------------------------------------------------------------------
// -- microfacet bsdf
// -----------------------------------------------------------------------------

// GGX microfacet BSDF. wi is eye -> surface, wo leaves surface.
// view direction is -wi. H is normalize(wi + wo).

// GGX normal distribution.
f32 fnGgxDistribution(f32 dotNorH, f32 a2) {
	f32 d = dotNorH * (a2 - 1.0) + 1.0;
	d = max(d, 1e-5);
	return a2 / (PI * d * d);
}

// Height-correlated Smith visibility.
// Folds in 1/(4*dotNorWo*dotNorWi) so don't have to do that calculation
// at the end of the microfacet (something i was previously doubling lmao)
f32 fnSmithGgxVisibility(f32 dotNorWi, f32 dotNorWo, f32 a2) {
	const f32 ggxV = dotNorWo * sqrt(dotNorWi * dotNorWi * (1.0 - a2) + a2);
	const f32 ggxL = dotNorWi * sqrt(dotNorWo * dotNorWo * (1.0 - a2) + a2);
	return 0.5 / max(ggxV + ggxL, 1e-5);
}

// Schlick Fresnel (scalar F0 to match mat.fresnel).
f32 fnSchlickFresnel(f32 dotHWi, f32 f0) {
	return f0 + (1.0 - f0) * pow(1.0 - dotHWi, 5.0);
}

// Sample a GGX half-vector around N from the NDF.
f32v3 fnSampleGgxH ( f32v3 N, f32 a2, f32v2 xi ) {
	f32 phi = TAU * xi.x;
	f32 cosT = sqrt((1.0 - xi.y) / (1.0 + (a2 - 1.0) * xi.y));
	f32 sinT = sqrt(max(1.0 - cosT * cosT, 0.0));
	f32v3 hLocal = f32v3(sinT * cos(phi), sinT * sin(phi), cosT);
	return Reorient_Hemisphere(hLocal, N);
}

f32 fnBsdfPdf ( f32v3 N, f32v3 wi, f32v3 wo, Material mat ) {
	// Transmission is treated as a near-delta lobe; handled by the caller.
	if ( mat.transmittive > 0.0 ) {
		return 1.0;
	}
	f32 dotNorWo = dot(N, wo);
	// Below the hemisphere contributes no reflection density.
	if ( dotNorWo <= 0.0 ) {
		return 0.0;
	}
	f32v3 H = -wi + wo;
	{
		// NaN guard for degenerate half-vector
		const f32 hlen = length(H);
		if (hlen < 1e-4) {
			// degenerate pdf
			return 0.0f;
		}
		H /= hlen;
	}
	const f32 dotNorH = max(dot(N, H), 0.0);
	const f32 dotHWi = clamp(dot(-wi, H), 0.0f, 1.0f);
	const f32 a2 = max(mat.alpha * mat.alpha, 0.0001f);
	// Half-vector NDF pdf converted to the outgoing direction.
	const f32 specPdf = (
		fnGgxDistribution(dotNorH, a2) * dotNorH / (4.0 * dotHWi)
	);
	const f32 diffPdf = dotNorWo * IPI;
	return mat.diffuse * diffPdf + (1.0 - mat.diffuse) * specPdf;
}

f32v3 fnBsdfSample (
	f32v3 N, f32v3 wi, f32v3 P, Material mat, out f32 pdf,
	inout f32 seed, inout f32v2 seed2
) {
	if ( mat.transmittive > 0.0 ) {
		f32v3 t = refract(wi, N, mat.transmittive);
		// refract returns 0 on total internal reflection; fall back.
		if ( dot(t, t) < 1e-8 ) {
			t = reflect(wi, N);
		}
		pdf = 1.0;
		return t;
	}
	f32 diffChance = fnSampleUniform(seed);
	// Diffuse lobe: sample direction, then report the shared combined pdf.
	if ( diffChance < mat.diffuse ) {
		f32v3 wo = fnSampleHemisphereCos(N, pdf, seed2);
		pdf = fnBsdfPdf(N, wi, wo, mat);
		return wo;
	}
	// Specular lobe: sample a half-vector, reflect the view across it.
	f32v2 xi = fnSampleUniform2(seed2);
	f32 a2 = max(mat.alpha * mat.alpha, 0.0001f);
	f32v3 H = fnSampleGgxH(N, a2, xi);
	f32v3 wo = 2.0 * dot(-wi, H) * H - -wi;
	pdf = fnBsdfPdf(N, wi, wo, mat);
	return wo;
}

f32v3 fnBsdfF ( f32v3 N, f32v3 wi, f32v3 wo, Material mat ) {
	if ( mat.transmittive > 0.0 ) {
		return IPI * mat.albedo;
	}
	f32v3 wiV = -wi;
	f32 dotNorWi = dot(N, wiV);
	f32 dotNorWo = dot(N, wo);
	if (dotNorWi <= 0.0 || dotNorWo <= 0.0) {
		return f32v3(0.0f);
	}
	f32v3 H = wiV + wo;
	{
		// NaN guard for degenerate half-vector
		const f32 hlen = length(H);
		if (hlen < 1e-4) {
			// degenerate half-vector, no specular contribution
			return f32v3(0.0f);
		} else {
			H /= hlen;
		}
	}
	const f32 dotNorH = clamp(dot(N, H), 0.0, 1.0f);
	const f32 dotHWi = clamp(dot(wiV, H), 0.0, 1.0f);
	const f32 a2 = max(mat.alpha * mat.alpha, 0.0001f);
	const f32 D = fnGgxDistribution(dotNorH, a2);
	const f32 G = fnSmithGgxVisibility(dotNorWi, dotNorWo, a2);
	const f32 F = fnSchlickFresnel(dotHWi, mat.fresnel);
	// no need for 1/(4*dotNorWo*dotNorWi), it's folded into G
	const f32 spec = D * G * F;
	const f32 diffuse = mat.diffuse;
	return (
		 (1.0 - diffuse) * spec * mat.albedo
		+ diffuse * mat.albedo * IPI
	);
}

// -----------------------------------------------------------------------------
// -- irradiance propagation
// -----------------------------------------------------------------------------

// no contributions were found. It's still okay to continue bouncing as well
// it's okay to use the accumulated irradiance. If there's no accumulated
// irradiance and the path is terminated, then no overall contribution
#define skHitNone 0

// a direct contribution was found. The path is terminated and the
// accumulated irradiance can be used. No further bouncing.
#define skHitDirect 1

// an indirect contribution was found. The path can continue bouncing, and
// on path termination the accumulated irradiance can be used.
#define skHitIndirect 2

// the path should be terminated. Any contribution can be used however
// if there is none accumulated, then no overall contribution.
#define skHitTerminate 3

// for now just super simple model
// this will find a new direction for bsdfWo as well as compute irradiance
int fnIrradiance(
	const Material mat,
	f32v3 itOri,
	f32v3 itNor,
	f32v3 itWi,
	inout f32v3 bsdfWo,
	inout f32v3 irradianceThroughput,
	inout f32v3 irradianceAccumulator,
	inout f32 seed,
	inout f32v2 seed2,

	inout Ray rayWo,
	inout f32v2 hitWo,

	in const int iteration
)
{
	int returnEnum = skHitNone;
	f32 bsdfPdf;
	f32 emitPdf;

	// -- propagate irradiance throughput along bsdf
	bsdfWo = fnBsdfSample(itNor, itWi, itOri, mat, bsdfPdf, seed, seed2);
	const f32v3 irradianceThroughputPrevious = irradianceThroughput;
	const f32 dotNorWo = dot(itNor, bsdfWo);

	// terminate path since this produced a bad direction
	if (dotNorWo <= 0.0f || bsdfPdf <= 0.0f) {
		return skHitTerminate;
	}

	irradianceThroughput *= (
		fnBsdfF(itNor, itWi, bsdfWo, mat) * dotNorWo / bsdfPdf
	);

	// -- terminate path if throughput is too low to contribute
	// this also helps prevent NaNs from propagating
	if (length(irradianceThroughput) < 1e-4f) {
		return skHitTerminate;
	}

	// -- russian roulette
	if (iteration > 2) {
		const f32 rrProbability = (
			clamp(
				max(
					irradianceThroughput.x,
					max(irradianceThroughput.y, irradianceThroughput.z)
				),
				0.15f, 1.0f
			)
		);
		if (fnSampleUniform(seed) > rrProbability) {
			return skHitTerminate;
		}
		irradianceThroughput /= rrProbability;
	}

	// -- optionally if not NaN hunting then terminate NaN paths
#if 1
	if (any(isnan(irradianceThroughput))) {
		return skHitTerminate;
	}
#endif

	// -- march towards surface to prepare for next hit, but also
	//    check if the hit surface is a radiance source
	rayWo = Ray(itOri + itNor*0.1f, bsdfWo);
	hitWo = (
		fnSceneMarch(
			rayWo,
			/*maxIterations=*/64,
			/*maxDistance=*/16.0f,
			/*threshold=*/0.01f
		)
	);

	int lightIndex = skLightIndexNone;

	// -- indirect irradiance (bsdf path)
	{
		// fetch the light index if it hit a light
		int bsdfLightIndex = LIGHT_IDX(hitWo.y);

		// hit sky. that's okay, just specialize it for sky
		if (hitWo.x < 0.0f) {
			bsdfLightIndex = skLightIndexSky;
		}

		// apply bsdf contribution to emitter when hitting a light
		if (fnValidEmitter(bsdfLightIndex, bsdfWo)) {
			lightIndex = bsdfLightIndex;
			const f32 emitterDist = hitWo.x;

			// use NEE sampling strategy for PDF so that it can be combined
			// with direct irradiance
			const f32 emitPdf = (
				  fnEmitPdf(lightIndex, bsdfWo, emitterDist)
				/ skLightsInSceneInclSky
			);

			// balance heuristic weight for BSDF strategy
			const f32 misWeightDenom = bsdfPdf + emitPdf;
			const f32 misWeight = (
				misWeightDenom > 0.0f ? bsdfPdf / misWeightDenom : 0.0f
			);

			// throughput contains the bounce's bsdfF.
			// arriving light is just emission, throughput and MIS weight.
			const f32v3 radiance = (
				  fnEmitterF(lightIndex, bsdfWo)
				* irradianceThroughput
				* misWeight
			);
			irradianceAccumulator += radiance;
			returnEnum = skHitIndirect;
		}
	}

	// -- direct irradiance (NEE path)
	{
		// if hit a light, then use the NEE sampling strategy on the same
		// light. otherwise just grab random light index
		if (lightIndex == -1) {
			lightIndex = int(fnSampleUniform(seed) * skLightsInSceneInclSky);
		}

		const f32v3 emitterPos = fnEmitterSample(lightIndex, itNor, seed2);
		const f32v3 emitterWo = normalize(emitterPos - itOri);
		const f32 emitterDist = length(emitterPos - itOri);

		f32v2 lightMarch = f32v2(999999.0f, -1.0f);

		// only march if the emitter is in the same hemisphere as the normal
		const bool sameHemisphere = dot(itNor, emitterWo) > 0.0f;
		if (sameHemisphere) {
			lightMarch = (
				fnSceneMarch(
					Ray(itOri + itNor*0.01f, emitterWo),
					/*maxIterations=*/32,
					/*maxDistance=*/64.0f,
					/*threshold=*/0.001f
				)
			);
		}

		bool visible = (
				(LIGHT_IDX(lightMarch.y) == lightIndex)
			&& fnValidEmitter(lightIndex, emitterWo)
		);
		if (sameHemisphere && lightIndex == skLightIndexSky) {
			// sky ray must miss otherwise non-visible to sky
			 visible = (lightMarch.y == -1.0f);
		}
		if (visible) {
			const f32 pdf = (
				  fnEmitPdf(lightIndex, emitterWo, emitterDist)
				/ skLightsInSceneInclSky
			);
			// reject degenerate PDFs to prevent NaNs
			if (pdf <= 0.0f) {
				return returnEnum;
			}

			// compute MISweight
			const f32 bsdfPdf = fnBsdfPdf(itNor, itWi, emitterWo, mat);
			const f32 misWeight = pdf / (pdf + bsdfPdf);

			const f32 dotNorWo = max(dot(itNor, emitterWo), 0.0f);
			const f32v3 radiance = (
				  fnEmitterF(lightIndex, emitterWo)
				* fnBsdfF(itNor, itWi, emitterWo, mat)
				* dotNorWo
				/ pdf
			);
			// use previous irradiance throughput as that one doesn't have the
			// bsdfF of the future bounce
			irradianceAccumulator += (
				radiance * irradianceThroughputPrevious * misWeight
			);
			returnEnum = skHitDirect;
		}
	}

	return returnEnum;
}

int fnPropagate(
	inout f32v3 itOri,
	inout f32v3 itNor,
	inout f32v3 itWi,
	inout f32 itMaterialId,
	inout f32v3 irradianceThroughput,
	inout f32v3 irradianceAccumulator,
	inout f32 seed,
	inout f32v2 seed2,
	in const int iteration
) {
	// -- compute irradiance on surface
	f32v3 bsdfWo;
	Material mat = inMaterial[int(itMaterialId)];

	// unpack material
	if (itMaterialId ==0) {
		// checkerboard pattern albedo and roughness
		float checker = mod(floor(itOri.x*0.5f) + floor(itOri.z*0.5f), 2.0f);
		mat.albedo = vec3(
			0.8f + 0.2f * checker,
			0.8f + 0.2f * checker,
			0.8f + 0.2f * checker
		);
		mat.alpha = 0.05f + 0.9f * checker;
		mat.diffuse = 0.01f + 0.9f * checker;
	}

	Ray rayWo;
	f32v2 hitWo;
	int returnEnum = (
		fnIrradiance(
			mat,
			itOri, itNor, itWi, bsdfWo,
			irradianceThroughput, irradianceAccumulator,
			seed, seed2,
			rayWo, hitWo,
			iteration
		)
	);

	// just immediately terminate if path is bad
	if (returnEnum == skHitTerminate) {
		return returnEnum;
	}

	// -- update iters
	itOri = rayWo.ori + rayWo.dir * hitWo.x + 0.01f*rayWo.dir;
	itNor = fnSceneNormal(itOri);
	itWi = rayWo.dir;
	itMaterialId = int(hitWo.y+0.5f);

	return returnEnum;
}

// -----------------------------------------------------------------------------
// -- irradiance bootstrap
// -----------------------------------------------------------------------------

void main() {
	// -- extract gbuffer
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	int linearIdx = px.y * skResolution.x + px.x;
	const GBuffer gbuf = data[linearIdx];

	// check if radiance has high alpha count, in which case can quit
	if (skAnimate == 0 && iFrame > 1000) {
		outRadiance[linearIdx] = vec4(0.0f);
		return;
	}

	// -- extract origin and normal
	f32v3 itOri = gbuf.ori;
	f32v3 itNor = gbuf.nor;
	f32v3 itWi = gbuf.wi;
	f32 itMaterialId = gbuf.materialId;

#define DBG_ID 1
#define DBG_ALBEDO 2
#define DBG_ROUGHNESS 3
#define DEBUG_VIEW 0
#if DEBUG_VIEW != 0
	if (true) {
		// random material
		#if DEBUG_VIEW == DBG_ID
		outRadiance[linearIdx] = vec4(
			vec3(
			(fract(sin(itMaterialId*0.2392)*39003.2302)),
			(fract(sin(itMaterialId*0.9392)*8422.2302)),
			(fract(sin(itMaterialId*0.0392)*89234.2302))),
			1.0f
		);
		#endif
		Material mat = inMaterial[int(itMaterialId)];

		// output albedo
		#if DEBUG_VIEW == DBG_ALBEDO
		outRadiance[linearIdx] = vec4(mat.albedo, 1.0f);
		#endif

		#if DEBUG_VIEW == DBG_ROUGHNESS
		outRadiance[linearIdx] = vec4(vec3(mat.alpha), 1.0f);
		#endif

		return;
	}
#endif

	// -- early out if no material
	if (itMaterialId < 0.0f) {
		outRadiance[linearIdx] = vec4(0.2f);
		return;
	}

	f32v4 historyAccumulator = vec4(0.0f);

	for (int i = 0; i < skSamplesPerPixel; ++i) {
		// create a new seed, need to reset dimension
		f32 seed = fnSampleSeed(px, i);
		f32v2 seed2 = fnSampleSeed2(px, i);

		// -- render loop
		f32v3 irradianceThroughput = vec3(1.0f);
		f32v3 irradianceAccumulator = vec3(0.0f);

		int hit = 0;
		for (int i = 0; i < skPropagationIterations; ++i) {
			int returnEnum = (
				fnPropagate(
					itOri, itNor, itWi,
					itMaterialId, irradianceThroughput, irradianceAccumulator,
					seed, seed2,
					i
				)
			);

			if (returnEnum == skHitNone) {
				continue;
			}

			if (returnEnum == skHitIndirect) {
				hit = 1;
				continue;
			}

			if (returnEnum == skHitDirect) {
				hit = 1;
				break;
			}

			if (returnEnum == skHitTerminate) {
				break;
			}
		}

		// debug for NaN hunts
		if (any(isnan(irradianceAccumulator)) && hit > 0)
		{
			outRadiance[linearIdx] = vec4(1.0f, 0.0f, 1.0f, -1.0f);
			return;
#if 0
			// in this mode just discard NaNs
			outRadiance[linearIdx] = vec4(0.0f);
#endif
			return;
		}

		// accumulate history for this iteration
		// clamp fireflies
		const float maxLuminance = 5.5f;
		float lum = dot(irradianceAccumulator, vec3(0.2126f, 0.7152f, 0.0722f));
		if (lum > maxLuminance) {
			irradianceAccumulator *= maxLuminance / lum;
		}
		historyAccumulator += vec4(irradianceAccumulator, 1.0f);

		// -- restore for next iteration
		itOri = gbuf.ori;
		itNor = gbuf.nor;
		itWi = gbuf.wi;
		itMaterialId = gbuf.materialId;
	}

	// -- write out final radiance
	// want to keep track of history so write out the alpha counter
	outRadiance[linearIdx] = (
		vec4(historyAccumulator.rgb / historyAccumulator.a, historyAccumulator.a)
	);
}
